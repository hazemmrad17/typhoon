{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/vigicrues/(.*)",
      "destination": "https://www.vigicrues.gouv.fr/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/diagnostic/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|diagnostic/|health|vigicrues/).*)",
      "destination": "/index.html"
    }
  ]
}
