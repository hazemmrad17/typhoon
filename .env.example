# Le projet fonctionne en mode local sans clé avec les sources publiques.
DVF_ENABLED=false
COPERNICUS_ENABLED=false

# Requis seulement si COPERNICUS_ENABLED=true — compte + jeton CDS
# (https://cds.climate.copernicus.eu, "Personal Access Token" dans votre
# profil). Voir le docstring de backend/app/connectors/copernicus.py.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Optionnel : active les recommandations générées par Mistral.
MISTRAL_API_KEY=

# Optionnel : augmentez cette valeur si votre connexion est lente.
HTTP_TIMEOUT_SECONDS=15

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Défaut : Vite en dev local uniquement. En production, listez le(s) domaine(s)
# réel(s) du frontend, ex. CORS_ALLOWED_ORIGINS=https://app.typhoon.example
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Typhoon Partner API (backend/partner_api) — clés des projets partenaires
# consommant POST /v1/analyze, format "nom:clé,nom:clé". Voir
# backend/partner_api/README.md.
PARTNER_API_KEYS=

# ══ Frontend (Vite) ══
# Un seul .env à la racine pour le front (VITE_*) et le back — Vite lit ce
# fichier via envDir: '..' dans frontend/vite.config.ts.

# Base URL de l'API backend (défaut : orchestrateur local).
VITE_API_BASE=http://127.0.0.1:8000
# Token public Mapbox (https://account.mapbox.com) — requis pour la carte.
VITE_MAPBOX_TOKEN=
# Style Mapbox (optionnel, défaut : sombre).
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/standard

# Authentification Supabase — absents = l'app tourne en mode démo (MOCK_USER
# connecté automatiquement, RequireAuth désactivé). Voir frontend/src/typhoon/auth.tsx.
# La clé "publishable" (anon key) est faite pour être publique côté client —
# ce n'est pas un secret, elle est protégée par les policies RLS Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
