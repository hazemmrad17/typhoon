# =============================================================================
# Typhoon — Configuration
# Copier ce fichier en .env et renseigner les valeurs.
# =============================================================================

# --- BDNB (aucune clé nécessaire) ---
# BDNB_API_KEY=                    # Optionnel, si vous avez une clé API
# BDNB_BASE_URL=https://api.bdnb.io

# --- Géorisques (public, sans clé) ---
# GEORISQUES_BASE_URL=https://www.georisques.gouv.fr/api/v1

# --- Géocodage (BAN / Géoplateforme IGN, public) ---
# GEOCODING_URL=https://data.geopf.fr/geocodage/search

# --- Copernicus Climate Data Store ---
# Activer les projections climatiques (2050/2100)
# Le premier lancement déclenche un téléchargement multi-gigaoctets.
COPERNICUS_ENABLED=false

# Identifiants Copernicus (requis si COPERNICUS_ENABLED=true)
# Créer un compte sur https://cds.climate.copernicus.eu
CDSAPI_URL=
CDSAPI_KEY=

# --- CORS ---
# Origines autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limitation de débit ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60.0
