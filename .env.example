# =============================================================================
# Typhoon — Configuration
# Copier ce fichier en .env et renseigner les valeurs.
# =============================================================================

# --- BDNB (aucune clé nécessaire) ---
# BDNB_API_KEY=                    # Optionnel, si vous avez une clé API
# BDNB_BASE_URL=https://api.bdnb.io

# --- Géorisques (public, sans clé) ---
# GEORISQUES_BASE_URL=https://www.georisques.gouv.fr/api/v1

# --- Géocodage (BAN / Géoplateforme IGN, public) ---
# GEOCODING_URL=https://data.geopf.fr/geocodage/search

# --- Attribution LO 2.0 (obligatoire dans le contrat) ---
# Source + date de dernière mise à jour du millésime utilisé.
# Mettre à jour la date à chaque nouvelle publication fournisseur.
ATTRIBUTION_GEORISQUES=Source Géorisques (BRGM / MTE) — données à jour au 2026-07-01
ATTRIBUTION_BDNB=Source BDNB (CSTB) — données à jour au 2026-07-01

# --- CORS ---
# Origines autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limitation de débit ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60.0
